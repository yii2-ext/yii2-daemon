{
  "name": "yii2-ext/yii2-daemon",
  "description": "Yii2 daemon based on ReactPHP",
  "type": "yii2-extension",
  "keywords": [
    "yii2",
    "daemon",
    "reactphp"
  ],
  "homepage": "https://packagist.org/packages/yii2-ext/yii2-daemon",
  "license": "MIT",
  "authors": [
    {
      "name": "Alexey Samoylov",
      "email": "alexey.samoylov@gmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/yii2-ext/yii2-daemon/issues",
    "source": "https://github.com/yii2-ext/yii2-daemon"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "require": {
    "php": "^8.1",
    "react/event-loop": "^1.6",
    "yiisoft/yii2": "^2.0.45"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "YarCode\\Yii2\\Daemon\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "YarCode\\Yii2\\Daemon\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  }
}
